# Copy to .env and fill in values
ELEVENLABS_API_KEY=your_key_here

# Debate provider (preserve its MINIMAL-thinking compatible default)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Research passage-selection provider: agnes (default), gemini, groq, openrouter, or openai (any OpenAI-compatible endpoint)
RESEARCH_MODEL_PROVIDER=agnes
# Optional research-only model override; does not change the debate model
RESEARCH_MODEL=
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
# Groq free tier: 1,000 requests/day per model; gpt-oss-20b keeps research off the debate's gpt-oss-120b quota
GROQ_API_KEY=
GROQ_RESEARCH_MODEL=openai/gpt-oss-20b
# OpenRouter: one key for many models; ":free" models allow 20 requests/min and 50/day without credits
OPENROUTER_API_KEY=
OPENROUTER_RESEARCH_MODEL=openai/gpt-oss-20b:free
# Generic (RESEARCH_MODEL_PROVIDER=openai): API root or full chat-completions URL, https only, plus RESEARCH_MODEL above
RESEARCH_MODEL_BASE_URL=
RESEARCH_MODEL_API_KEY=

# Optional deep research search provider
THUNDERBIT_API_KEY=

# Bounded public web search for quick and deep research: exa (default) or none.
# Optional EXA_API_KEY below selects REST; otherwise uses public MCP access.
RESEARCH_WEB_SEARCH=exa

# Community sources: all (default), none, or an ordered comma-separated subset.
# IDs: stackexchange,discourse,wordpress,telegram,youtube,x,wikipedia,crossref
# Deep requests select at most three matching, configured sources.
RESEARCH_COMMUNITY_SOURCES=all
EXA_API_KEY=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
